FROM python:3.13

# Tell dbt where to find profiles.yml (otherwise it looks in ~/.dbt/)
ENV DBT_PROFILES_DIR=/pipeline

WORKDIR /pipeline

# Install dependencies first so Docker can cache this layer
# when only the code changes
COPY pyproject.toml uv.lock ./
RUN pip install --no-cache-dir uv
RUN uv sync --frozen --no-dev --no-install-project

# Copy the project code: dlt (extract/load), dbt (transformations),
# Dagster (orchestration) and dbt's connection settings
COPY data_load_extract/ ./data_load_extract/
COPY data_transformation/ ./data_transformation/
COPY orchestration/ ./orchestration/
COPY profiles.yml /pipeline/profiles.yml

# Install the project itself and the dbt packages
RUN uv sync --frozen --no-dev
RUN uv run dbt deps --project-dir data_transformation/dbt_flights

# Start the Dagster dev server (UI + scheduler) on port 3000,
# listening on all interfaces so it is reachable from outside the container
WORKDIR /pipeline/orchestration
CMD ["uv", "run", "--frozen", "--no-dev", "dagster", "dev", "-m", "orchestration.definitions", "-h", "0.0.0.0", "-p", "3000"]