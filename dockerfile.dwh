FROM python:3.13

ENV DBT_PROFILES_DIR=/pipeline 
ENV PYTHONPATH=/pipeline/orchestration/src

WORKDIR /pipeline
COPY pyproject.toml uv.lock ./

RUN pip install --no-cache-dir uv
RUN uv sync --frozen --no-dev

COPY data_load_extract/ ./data_load_extract/
COPY data_transformation/ ./data_transformation/
COPY profiles.yml /pipeline/profiles.yml
COPY orchestration/ ./orchestration/

WORKDIR /pipeline/orchestration

CMD ["uv", "run", "dagster", "dev", "-m", "orchestration.definitions", "-h", "0.0.0.0", "-p", "3000"]