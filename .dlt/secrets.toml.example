# Copy to secrets.toml in the same folder and fill out.
# Never commit secrets.toml

[destination.snowflake.credentials]
database = "swedavia_db"
username = "<snowflake-user>"
password = "<pw>"
host = "<orgname-accountname>"   # account identifier, ex. ABCDEFG-XY12345
warehouse = "swedavia_wh"
role = "flight_dlt_role"