Table dim_date {
  date_id varchar [pk, note: 'YYYYMMDD']
  date date [not null, unique]
  year int
  month int
  day int
}

Table dim_airline {
  airline_id varchar [pk, note: 'surrogate key']
  airline_iata varchar [note: 'match against Wikipedia']
  airline_icao varchar
  airline_name varchar
  country varchar [note: 'Wikipedia']
}

Table dim_airport {
  airport_id varchar [pk, note: 'surrogate key']
  airport_iata varchar [note: 'match against Wikipedia']
  airport_icao varchar
  airport_name varchar
  city varchar
}

Table fact_arrivals {
  arrival_id varchar [pk, note: 'Surrogate key']
  flight_number varchar [note: 'Swedavias flightId, degenerate dimension']
  date_id varchar [not null, ref: > dim_date.date_id, note: 'scheduled arrival day, derived from scheduled_arrival_utc']
  airline_id varchar [ref: > dim_airline.airline_id]
  arrival_airport_id varchar [ref: > dim_airport.airport_id, note: 'Swedavia-airport']
  departure_airport_id varchar [ref: > dim_airport.airport_id, note: 'Departure airport for plane']
  flight_status_code varchar [note: 'flightLegStatus code']
  flight_status varchar [note: 'flightLegStatus English']
  scheduled_arrival_utc timestamp
  estimated_arrival_utc timestamp
  actual_arrival_utc timestamp
  data_fetched_date date [note: 'ingestion date from src']
}

Table fact_departures {
  departure_id varchar [pk, note: 'Surrogate key']
  flight_number varchar [note: 'Swedavias flightId, degenerate dimension']
  date_id varchar [not null, ref: > dim_date.date_id, note: 'scheduled departure day, derived from scheduled_departure_utc']
  airline_id varchar [ref: > dim_airline.airline_id]
  departure_airport_id varchar [ref: > dim_airport.airport_id, note: 'Swedavia-airport']
  arrival_airport_id varchar [ref: > dim_airport.airport_id, note: 'destination']
  flight_status_code varchar [note: 'flightLegStatus code']
  flight_status varchar [note: 'flightLegStatus English']
  scheduled_departure_utc timestamp
  estimated_departure_utc timestamp
  actual_departure_utc timestamp 
  data_fetched_date date [note: 'ingestion date from src']
}